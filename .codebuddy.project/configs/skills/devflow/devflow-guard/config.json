{
  "version": 1,
  "_comment": "本文件为 devflow-guard 的项目配置：docs_root/dirs 决定文档放在哪、overview 决定总览表的列序与合法取值、file_header 决定文件头字段与生成器标识、capability_name_pattern 决定能力名合法模式。本文件是这些形状的唯一来源——脚本不内置任何默认值，缺失、损坏或缺少必需键时直接报错退出（退出码 3）。首次使用先执行技能的 init 模式初始化文档结构。",
  "docs_root": "extensions_docs",
  "dirs": {
    "explore": "explore",
    "design": "design",
    "plans": "plans",
    "testing": "testing",
    "decisions": "decisions",
    "archive": "archive"
  },
  "overview": {
    "file": "README.md",
    "header": [
      "能力",
      "状态",
      "设计",
      "实施计划",
      "实施偏差",
      "测试",
      "决策记录"
    ],
    "status_values": [
      "草稿",
      "评审中",
      "已定",
      "已实施",
      "已废弃"
    ],
    "placeholder_dash": "—",
    "placeholder_todo": "待补",
    "capability_column": 0,
    "status_column": 1
  },
  "file_header": {
    "fields": [
      "状态",
      "关联能力",
      "创建日期",
      "更新日期"
    ],
    "status_field": "状态",
    "generator_field": "生成器",
    "generator_values": [
      "devflow-guard/new"
    ]
  },
  "capability_name_pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
}

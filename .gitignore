*.so
*.bat

# Distribution / packaging
.Python
test/
logs/
# PyInstaller 产物：extensions_testbed 的单文件 EXE 在 dist/，
# 中间文件在 build/pyinstaller/。两者都不入库。
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# 锚定到仓库根（前导 /）：这些是 Python 打包在根目录产生的产物目录，
# 未锚定时会按「任意层级同名目录」匹配，误伤
#   - .codebuddy/lib/         引擎可选包载体（随子模块分发，必须保留）
#   - .codebuddy.project/configs/  项目侧入库配置
# PyAppify 复制项目到 working 时按目录判忽略，被命中的整目录会被直接跳过，
# 且深层 .gitignore 的反选无处生效（目录本身已被排除，不再往下遍历）。
/lib/
/lib64/
/parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
venv/
.venv/
# 锚定到仓库根：未锚定时会匹配 .codebuddy/lib/python/（引擎内 python 可选包），
# 使该包在 PyAppify 复制时被整目录跳过。
/python/

# PyInstaller
# Usually these files are written by a python script from a template
# before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest

# Installer logs
pip-log.txt
pip-delete-this-directory.txt
autohelper
working_images/

cache/
